# Entorno: development | test | production
NODE_ENV=development
# Interfaz de escucha. 127.0.0.1 = solo esta máquina.
HOST=127.0.0.1
PORT=4000
# La URL y el token de la BD NO van aqui: se guardan cifrados en data/vault.db (se configuran
# desde el asistente de primer arranque o desde Administracion). Aqui solo vive APP_MASTER_KEY.
# libsql | sqlite (respaldo, solo URLs file:)
DB_DRIVER=libsql
# Origen permitido por CORS (URL del front)
CORS_ORIGIN=http://localhost:3000
# Orquestador (Fase 2)
ORCHESTRATOR=llm  # llm = Sheldon y los agentes trabajan; off = apagado

# --- Documentación (Swagger) ---
# false en producción
DOCS_ENABLED=true
API_PUBLIC_ORIGIN=http://localhost:4000

# --- Seguridad ---
# Las genera `python scripts/setup_env.py` (32 bytes aleatorios en base64). No las pegues aquí: van en tu .env local.
# APP_MASTER_KEY es el único secreto que queda en el .env: abre la bóveda cifrada (data/vault.db).
APP_MASTER_KEY=
SESSION_SECRET=
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8

# --- Backups ---
BACKUP_DIR=backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# true = permite cambiar la BD desde el panel (por defecto false: solo se ve, no se cambia)
ADMIN_ALLOW_DB_CHANGE=false
