# Entorno: development | test | production
NODE_ENV=development
# Interfaz de escucha. 127.0.0.1 = solo esta máquina.
HOST=127.0.0.1
PORT=4000
# Local: archivo relativo al proyecto. Nube: libsql://<db>-<org>.turso.io
TURSO_DATABASE_URL=file:local.db
# Vacío en local. Obligatorio con Turso en la nube.
TURSO_AUTH_TOKEN=
# Origen permitido por CORS (URL del front)
CORS_ORIGIN=http://localhost:3000
# Fase 2: único valor válido en Fase 1
ORCHESTRATOR=noop

# --- Seguridad ---
# Las genera `npm run setup` (32 bytes aleatorios en base64). No las pegues aquí: van en tu .env local.
APP_ENCRYPTION_KEY=
SESSION_SECRET=
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8

# --- Backups ---
BACKUP_DIR=backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# false = la conexión de BD solo se ve en el panel, no se cambia
ADMIN_ALLOW_DB_CHANGE=true
