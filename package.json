{
  "name": "flowclic-oficina-ia-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de FlowClic Oficina IA (Fase 1)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env seeds/seed.ts",
    "db:reset": "node --env-file-if-exists=.env src/db/reset.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
